# EAS build archive rules (EAS ignores .gitignore when this exists).
# Keep the archive small: dependencies, caches, native folders, and any
# loose media dropped into this folder stay out. Bundled app assets
# (assets/**) are untouched.

node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
/ios
/android

# Loose media at the top of app/ (not the bundled assets folder)
/*.mp4
/*.mp3
/*.mov
/*.zip
/*.ipa
